{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec,
    warn_export_vars,
    warn_unused_import,
    warn_obsolete_guard,
    %% roadrunner is not a dependency: the handler never calls it, and the
    %% node that runs it already has roadrunner, since roadrunner is what
    %% calls the handler. Without it on the code path the
    %% `roadrunner_event_handler` behaviour is unknown at compile time;
    %% the test suite runs the callback against a real roadrunner.
    nowarn_undefined_behaviour
]}.

%% A range, not a pin: as a library, an exact version would clash with
%% any other `telemetry` 1.x the user's project resolves.
{deps, [
    {telemetry, "~> 1.0"}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_hank, "2.0.0"},
    {rebar3_hex, "7.3.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.{erl,hrl,app.src}",
        "test/*.{erl,hrl}"
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all, nowarn_missing_spec]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]},
        {deps, [
            %% Pinned to the roadrunner commit that adds the close reason
            %% to `listener_conn_close`; moves to the Hex release that
            %% ships it.
            {roadrunner,
                {git, "https://github.com/arizona-framework/roadrunner.git",
                    {ref, "c5b0bc2da229d9dfb21aa387bb2e4e4e8eb1bd2e"}}}
        ]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.

{ct_opts, [{sys_config, ["config/test.config"]}]}.

%% `no_undefined_callbacks`: roadrunner is not a dependency, so the
%% `roadrunner_event_handler` callback info is never in the PLT and
%% dialyzer would only report that it is missing.
{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling, no_undefined_callbacks]},
    {plt_apps, top_level_deps}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{hank, [
    {ignore, [
        %% Common Test callbacks (`init_per_*`, `end_per_*`, per-testcase
        %% `TestCase(Config)`) have fixed arities, so hank's
        %% `unnecessary_function_arguments` rule flags the unused `Config`.
        {"test/roadrunner_telemetry_SUITE.erl", unnecessary_function_arguments}
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, true},
    {source_url, "https://github.com/arizona-framework/roadrunner_telemetry"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{alias, [
    {doc, [ex_doc]},
    {precommit, [
        {fmt, "--check"},
        compile,
        xref,
        hank,
        dialyzer,
        ex_doc,
        {ct, "--cover"},
        {cover, "--verbose --min_coverage=100"}
    ]}
]}.
