{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_missing_spec,
    warn_export_vars,
    warn_unused_import,
    warn_obsolete_guard
]}.

{deps, [
    {roadrunner, "~> 0.13"},
    {telemetry, "~> 1.4"}
]}.

{project_plugins, [
    {erlfmt, "1.8.0"},
    {rebar3_hank, "2.0.0"},
    {rebar3_hex, "7.3.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{erlfmt, [
    write,
    {files, [
        "rebar.config",
        "src/*.{erl,hrl,app.src}",
        "test/*.{erl,hrl}"
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all, nowarn_missing_spec]},
        {extra_src_dirs, [{"test", [{recursive, true}]}]}
    ]}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.

{ct_opts, [{sys_config, ["config/test.config"]}]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {plt_apps, top_level_deps},
    %% Not in the `applications` list (the handler only runs inside a
    %% node that already started roadrunner), so add it for its types
    %% and the `roadrunner_event_handler` behaviour.
    {plt_extra_apps, [roadrunner]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{hank, [
    {ignore, [
        %% Common Test callbacks (`init_per_*`, `end_per_*`, per-testcase
        %% `TestCase(Config)`) have fixed arities, so hank's
        %% `unnecessary_function_arguments` rule flags the unused `Config`.
        {"test/roadrunner_telemetry_SUITE.erl", unnecessary_function_arguments}
    ]}
]}.

{ex_doc, [
    {extras, [
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ]},
    {main, "README.md"},
    {api_reference, true},
    {source_url, "https://github.com/arizona-framework/roadrunner_telemetry"},
    {prefix_ref_vsn_with_v, false}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{alias, [
    {doc, [ex_doc]},
    {precommit, [
        {fmt, "--check"},
        compile,
        xref,
        hank,
        dialyzer,
        ex_doc,
        {ct, "--cover"},
        {cover, "--verbose --min_coverage=100"}
    ]}
]}.
